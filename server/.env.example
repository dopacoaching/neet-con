NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://localhost:27017/neetcon2026

# JWT
JWT_SECRET=replace_this_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Bootstrap admin login(s) — "email:password" pairs (comma-separated for more).
# Logs in as full "admin" role without seeding the DB. Keep secret.
ADMIN_CREDENTIALS=admin@example.com:change_this_password

# App
CLIENT_URL=http://localhost:5173
# Set to "false" to close registrations (the public form rejects new
# registrations with a clear message). Defaults to open when unset.
REGISTRATIONS_OPEN=true

# Event details shown in the confirmation message / entry pass / emails
EVENT_DATE=Saturday, 1 August 2026
EVENT_TIME=9:30 AM onwards
EVENT_VENUE=Bhatia Hall, Kuttikatoor, Kozhikode
EVENT_MAP_URL=https://maps.app.goo.gl/5xkHbG9FUSHaFLRQ6

# Extra origins allowed to call the API, beyond CLIENT_URL (comma-separated).
EXTRA_ALLOWED_ORIGINS=

# Email (SMTP) — backup confirmation + organizer notification.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your.gmail@gmail.com
SMTP_PASS=your_gmail_app_password
MAIL_FROM=CareerX <your.gmail@gmail.com>
ORGANIZER_EMAIL=team@example.com

# One-off guest-count follow-up campaign template (server/scripts/sendGuestCountAsk.js)
WHATSAPP_GUESTCOUNT_TEMPLATE_NAME=your_approved_template_name

# WhatsApp confirmation (Meta WhatsApp Cloud API) — PRIMARY delivery channel.
# Confirmation + entry QR are sent to the registrant's WhatsApp (mobileNumber).
# Requires an approved message template (UTILITY, image header + 7 body vars);
# see server/utils/whatsapp.js for the exact template spec.
#  - WHATSAPP_MOCK=true            -> simulate locally (no real send).
#  - false + creds below           -> real delivery via Meta Cloud API.
WHATSAPP_MOCK=true
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_permanent_access_token
# Webhook verification token — any random string you choose; paste the same
# value into Meta's app Webhooks config when setting the callback URL.
WHATSAPP_VERIFY_TOKEN=some_random_verify_string
# Meta app secret — when set, the webhook verifies Meta's X-Hub-Signature-256
# so forged webhook events are rejected. Optional (leave blank to skip).
WHATSAPP_APP_SECRET=
WHATSAPP_TEMPLATE_NAME=careerx_confirmation
# One-off day-before event reminder (server/scripts/sendReminder.js)
WHATSAPP_REMINDER_TEMPLATE_NAME=careerx_reminder
WHATSAPP_TEMPLATE_LANG=en
WHATSAPP_COUNTRY_CODE=91
WHATSAPP_API_VERSION=v21.0
