NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://localhost:27017/neetcon2026

# JWT
JWT_SECRET=replace_this_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Bootstrap admin login(s) — "email:password" pairs (comma-separated for more).
# Logs in as full "admin" role without seeding the DB. Keep secret.
ADMIN_CREDENTIALS=admin@example.com:change_this_password

# App
CLIENT_URL=http://localhost:5173
# Set to "false" to close registrations (the public form rejects new
# registrations with a clear message). Defaults to open when unset.
REGISTRATIONS_OPEN=true

# Event details shown in the confirmation message / entry pass / emails.
# Online event — EVENT_MAP_URL is repurposed as the join/meeting link; leave
# blank until confirmed (email/pass fall back to "shared before the event").
EVENT_DATE=Saturday, 15 August 2026
EVENT_TIME=7:30 PM
EVENT_VENUE=Online
EVENT_MAP_URL=

# Extra origins allowed to call the API, beyond CLIENT_URL (comma-separated).
EXTRA_ALLOWED_ORIGINS=

# Email (SMTP) — backup confirmation + organizer notification.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your.gmail@gmail.com
SMTP_PASS=your_gmail_app_password
MAIL_FROM=CareerX <your.gmail@gmail.com>
ORGANIZER_EMAIL=team@example.com

# One-off guest-count follow-up campaign template (server/scripts/sendGuestCountAsk.js)
WHATSAPP_GUESTCOUNT_TEMPLATE_NAME=careerx_guest_count_update

# WhatsApp confirmation (Meta WhatsApp Cloud API) — PRIMARY delivery channel.
# Confirmation + entry QR are sent to the registrant's WhatsApp (mobileNumber).
# Requires an approved message template (UTILITY, image header + 7 body vars);
# see server/utils/whatsapp.js for the exact template spec.
#  - WHATSAPP_MOCK=true            -> simulate locally (no real send).
#  - false + creds below           -> real delivery via Meta Cloud API.
WHATSAPP_MOCK=true
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_permanent_access_token
# Webhook verification token — any random string you choose; paste the same
# value into Meta's app Webhooks config when setting the callback URL.
WHATSAPP_VERIFY_TOKEN=some_random_verify_string
# Meta app secret — when set, the webhook verifies Meta's X-Hub-Signature-256
# so forged webhook events are rejected. Optional (leave blank to skip).
WHATSAPP_APP_SECRET=
WHATSAPP_TEMPLATE_NAME=careerx_confirmation_v7
# One-off day-before event reminder (server/scripts/sendReminder.js)
WHATSAPP_REMINDER_TEMPLATE_NAME=careerx_event_reminder_v3
WHATSAPP_TEMPLATE_LANG=en
WHATSAPP_COUNTRY_CODE=91
WHATSAPP_API_VERSION=v21.0
# WhatsApp Business Account ID — only needed for template CREATION scripts
# (POST /{waba-id}/message_templates), not for sending. Find it in Meta
# Business Manager > WhatsApp Manager > API setup.
WHATSAPP_WABA_ID=your_waba_id
# One-off CareerX invite to old NEET CON 2026 registrants (server/scripts/createNeetconInviteTemplate.js)
# v2 fixes v1's incorrect "Bhatia Hall" physical venue text (event moved online).
WHATSAPP_NEETCON_INVITE_TEMPLATE_NAME=careerx_neetcon_invite_v2

# One-off "event moved to online mode" update to already-confirmed CareerX
# registrants (server/scripts/createModeUpdateTemplate.js + sendModeUpdate.js)
WHATSAPP_MODE_UPDATE_TEMPLATE_NAME=careerx_mode_update_v1

# One-off venue-correction follow-up for everyone already sent the v1 NEET CON
# invite with the wrong "Bhatia Hall" address (server/scripts/createNeetconCorrectionTemplate.js
# + sendNeetconCorrection.js)
WHATSAPP_NEETCON_CORRECTION_TEMPLATE_NAME=careerx_neetcon_correction_v1

# One-off "rescheduled to evening 7:30 PM today" update sent 2026-08-13
# (server/scripts/createRescheduleTemplate.js + sendReschedule.js)
WHATSAPP_RESCHEDULE_TEMPLATE_NAME=careerx_reschedule_evening_v1

# One-off "meeting starts in 15 minutes" reminder sent 2026-08-13, 7:15 PM IST
# (server/scripts/createMeetingStartingTemplate.js + sendMeetingStarting.js,
# also triggerable via POST /api/whatsapp/trigger-meeting-starting)
WHATSAPP_MEETING_STARTING_TEMPLATE_NAME=careerx_meeting_starting_v1
MEETING_STARTING_ZOOM_LINK=https://us06web.zoom.us/j/84104668901?pwd=MTNBItV4sbuiOUzQ1u7WWueG1DwNfG.1
# Shared secret so an external scheduler (GitHub Actions cron) can call
# POST /api/whatsapp/trigger-meeting-starting without an admin login session.
CRON_TRIGGER_SECRET=replace_this_with_a_long_random_secret
# Admin's own WhatsApp number — receives the automatic "broadcast finished"
# status report after trigger-meeting-starting runs (leave blank to disable).
BROADCAST_REPORT_NUMBER=
WHATSAPP_BROADCAST_REPORT_TEMPLATE_NAME=careerx_broadcast_report_v1

# v7 confirmation template — no header (event has no physical gate to scan a
# QR at), no guest_count, swaps the stale "show QR at entry desk" line for a
# WhatsApp-group join line (server/scripts/createConfirmationV7Template.js).
# Once approved, point WHATSAPP_TEMPLATE_NAME at this.
WHATSAPP_CONFIRMATION_V7_TEMPLATE_NAME=careerx_confirmation_v7

# Google Sheets sync (admin dashboard "Sync to Google Sheet" button) — replaces
# the old Excel export. Auth is a Google Cloud service account (not user OAuth),
# since this runs unattended from a server-side button click. Setup:
#   1. Google Cloud Console -> create/select a project -> enable "Google Sheets API"
#   2. IAM & Admin -> Service Accounts -> create one -> Keys -> Add Key -> JSON
#   3. From the downloaded JSON, copy "client_email" and "private_key" below
#   4. Create the target Google Sheet, then "Share" it with the service
#      account's email (the client_email above) as Editor
#   5. Copy the Sheet ID from its URL: .../spreadsheets/d/<THIS PART>/edit
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEET_ID=your_google_sheet_id
